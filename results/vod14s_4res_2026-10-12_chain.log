##### scripts used for this set (data generation, chain 2, chain 3)
##### make_vod_clips_480_720.sh
#!/usr/bin/env bash
# Same source range and encoder settings as make_vod_clips.sh (1080p/360p), adding 720p and 480p originals and
# 14 s stream-copied scene clips + 16 kHz mono WAV, 230 per resolution at the same time offsets.
set -euo pipefail
FF=~/miniconda3/envs/ffmpeg/bin/ffmpeg
SRC=/gpfs/public/datasets/2026-worldcup-full-match/ARG_vs_ALG_groupJ_match1.mp4
OUT=~/nvdec-runs/vod; cd $OUT
enc() { # res scale vbitrate maxrate bufsize
  $FF -hide_banner -loglevel warning -stats -ss 00:10:00 -t 3300 -i $SRC \
    -vf "fps=30000/1001,$2,format=yuv420p" -c:v libx264 -preset faster -profile:v high -b:v $3 -maxrate $4 -bufsize $5 \
    -g 60 -keyint_min 60 -sc_threshold 0 -c:a aac -ar 48000 -ac 2 -b:a 128k -movflags +faststart -y orig_$1.mp4
}
enc 720p "scale=1280:720" 2500k 2800k 5000k
enc 480p "scale=854:480"  1200k 1400k 2400k
for res in 720p 480p; do
  d=clips_${res}_14s; mkdir -p $d
  for i in $(seq 0 229); do
    start=$(( i * 14 ))
    $FF -hide_banner -loglevel error -y -ss $start -i orig_$res.mp4 -t 14 -c copy -avoid_negative_ts make_zero $d/clip_$(printf %04d $i).mp4
    $FF -hide_banner -loglevel error -y -ss $start -i orig_$res.mp4 -t 14 -vn -ac 1 -ar 16000 -acodec pcm_s16le $d/clip_$(printf %04d $i).wav
  done
  echo "done $d: $(ls $d/*.mp4 | wc -l) clips, $(du -sh $d | cut -f1)"
done
echo VOD_DATA_480_720_DONE

##### run_chain_vod2.sh
#!/usr/bin/env bash
# VOD 14 s clips at 480p and 720p (3 configs each, as run_chain_vod.sh), plus the two OpenCV "production" runs for
# 360p and 1080p repeated under this pod CPU quota (32 cores; the earlier runs had 128) for a like-for-like set.
# Waits for the data and for an idle GPU (another process may be using the single GPU) before each run.
gpu_idle() { [ "$(nvidia-smi --query-compute-apps=pid --format=csv,noheader | wc -l)" = 0 ] && [ "$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits -i 0)" -lt 2000 ]; }
until grep -q VOD_DATA_480_720_DONE ~/nvdec-runs/make_vod_clips_480_720.log 2>/dev/null; do sleep 30; done
cd ~/nvdec-poc/bench
export MODEL=/gpfs/public/artifacts/models/Qwen/Qwen3-Omni-30B-A3B-Instruct
export REASONING_PARSER= MAX_MODEL_LEN=49152 MAX_BATCHED=49152 GPU_UTIL=0.9
export MM_KWARGS="{\"max_pixels\":313600,\"fps\":2.0}" STRUCTURED="{\"backend\":\"xgrammar\",\"disable_any_whitespace\":true}"
export SYSTEM_PROMPT="$(cat ~/nvdec-poc/bench/prod/live_system_prompt.txt)" RESPONSE_FORMAT=@$HOME/nvdec-poc/bench/prod/live_response_format.json
export PROMPT= MAX_TOKENS=2048 VIDEO_URL_EXTRA="{\"fps\":2.0,\"min_pixels\":16384,\"max_pixels\":313600}"
export CLIP_EXT=mp4 AUDIO_URL_BASE=http://127.0.0.1:8890/a BURSTS="8 64" REPS=2
NV="{\"video\":{\"backend\":\"pynvvideocodec\",\"hw_decoders\":2}}"
CPU="{\"video\":{\"backend\":\"opencv\"}}"
run() { # label asc mps media-io
  until gpu_idle; do echo "$(date -u +%H:%M:%S) GPU busy, waiting"; sleep 60; done
  ASC=$2 MPS=$3 OUT=$HOME/nvdec-runs/$1 bash ./live_stage_matrix.sh $1 "$4"
}
for res in 480p 720p; do
  export SEG=$HOME/nvdec-runs/vod/clips_${res}_14s
  run vod-${res}-prod        3  0 "$CPU"
  run vod-${res}-nvdec       3  1 "$NV"
  run vod-${res}-nvdec-asc12 12 1 "$NV"
done
for res in 1080p 360p; do
  export SEG=$HOME/nvdec-runs/vod/clips_${res}_14s
  run vod-${res}-prod-cpu32  3  0 "$CPU"
done
echo CHAIN_VOD2_DONE

##### run_chain_vod3.sh
#!/usr/bin/env bash
# After run_chain_vod2.sh: the NVDEC configs for 360p and 1080p under this pod (32-core quota), so that all four
# resolutions x three configs form one uniform set. Output dirs carry the -cpu32 suffix like the OpenCV re-runs.
gpu_idle() { [ "$(nvidia-smi --query-compute-apps=pid --format=csv,noheader | wc -l)" = 0 ] && [ "$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits -i 0)" -lt 2000 ]; }
until grep -q CHAIN_VOD2_DONE ~/nvdec-runs/run_chain_vod2.log 2>/dev/null; do sleep 60; done
cd ~/nvdec-poc/bench
export MODEL=/gpfs/public/artifacts/models/Qwen/Qwen3-Omni-30B-A3B-Instruct
export REASONING_PARSER= MAX_MODEL_LEN=49152 MAX_BATCHED=49152 GPU_UTIL=0.9
export MM_KWARGS="{\"max_pixels\":313600,\"fps\":2.0}" STRUCTURED="{\"backend\":\"xgrammar\",\"disable_any_whitespace\":true}"
export SYSTEM_PROMPT="$(cat ~/nvdec-poc/bench/prod/live_system_prompt.txt)" RESPONSE_FORMAT=@$HOME/nvdec-poc/bench/prod/live_response_format.json
export PROMPT= MAX_TOKENS=2048 VIDEO_URL_EXTRA="{\"fps\":2.0,\"min_pixels\":16384,\"max_pixels\":313600}"
export CLIP_EXT=mp4 AUDIO_URL_BASE=http://127.0.0.1:8890/a BURSTS="8 64" REPS=2
NV="{\"video\":{\"backend\":\"pynvvideocodec\",\"hw_decoders\":2}}"
run() { until gpu_idle; do echo "$(date -u +%H:%M:%S) GPU busy, waiting"; sleep 60; done; ASC=$2 MPS=$3 OUT=$HOME/nvdec-runs/$1 bash ./live_stage_matrix.sh $1 "$4"; }
for res in 1080p 360p; do
  export SEG=$HOME/nvdec-runs/vod/clips_${res}_14s
  run vod-${res}-nvdec-cpu32       3  1 "$NV"
  run vod-${res}-nvdec-asc12-cpu32 12 1 "$NV"
done
echo CHAIN_VOD3_DONE

