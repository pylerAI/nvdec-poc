#!/usr/bin/env bash
# 6 s HLS MPEG-TS segments at 1080p from genuine 1080p sports broadcast (worldcup match), encoder characteristics
# copied from the production 360p segment seg6.ts: H.264 High, 29.97 fps, 2 B-frames, 1 ref, one IDR per segment
# (GOP = whole segment), AAC-LC 16 kHz mono ~48 kbps. Only resolution and bitrate change (1920x1080, 4.5 Mbps ABR).
set -euo pipefail
FF=~/miniconda3/envs/ffmpeg/bin/ffmpeg
SRC=/gpfs/public/datasets/2026-worldcup-full-match/ARG_vs_ALG_groupJ_match1.mp4
OUT=~/nvdec-runs/segments-1080p
cd $OUT && rm -f seg_*.ts playlist.m3u8
$FF -hide_banner -loglevel warning -stats -ss 00:10:00 -t 4806 -i $SRC \
  -vf "fps=30000/1001,format=yuv420p" -c:v libx264 -preset faster -profile:v high -level 4.0 \
  -b:v 4500k -maxrate 5000k -bufsize 9000k -bf 2 -refs 1 \
  -g 180 -keyint_min 180 -sc_threshold 0 -force_key_frames "expr:gte(t,n_forced*6.006)" \
  -c:a aac -ar 16000 -ac 1 -b:a 48k \
  -f hls -hls_time 6 -hls_segment_type mpegts -hls_list_size 0 -hls_flags independent_segments \
  -hls_segment_filename "seg_%04d.ts" playlist.m3u8
echo SEGMENTS_DONE
no leftover processes
